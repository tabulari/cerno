# =============================================================================
# Cerno SRE Triage Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set for the system to function.
# Variables marked [OPTIONAL] have sensible defaults.
# Set MOCK_MODE=true to run the full pipeline without any external API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (OpenRouter)
# -----------------------------------------------------------------------------
# [REQUIRED] Get your key at https://openrouter.ai/keys
# Used by all three sub-agents (CodeAnalyst, LogParser, SeverityScorer)
# and the Instructor fallback path.
OPENROUTER_API_KEY=

# [OPTIONAL] Override default models. Defaults shown below.
# CodeAnalyst and LogParser use Flash; SeverityScorer uses Pro.
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
OPENROUTER_MODEL_STRONG=google/gemini-2.5-pro

# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------
# [OPTIONAL] Required only if you want Telegram intake.
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Observability — Langfuse (self-hosted)
# -----------------------------------------------------------------------------
# [OPTIONAL] Auto-generated on first Langfuse boot. Set these after
# creating a project in the Langfuse UI at http://localhost:3001.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# [OPTIONAL] Internal Docker network URL. Do not change unless you
# renamed the langfuse service in docker-compose.yml.
LANGFUSE_HOST=http://langfuse:3000

# -----------------------------------------------------------------------------
# Redis — State Machine, Pub/Sub, Rate Limiting
# -----------------------------------------------------------------------------
# [OPTIONAL] Default works with the bundled Redis container.
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Qdrant — Vector Database (RAG + Incident Deduplication)
# -----------------------------------------------------------------------------
# [OPTIONAL] Default works with the bundled Qdrant container.
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# [OPTIONAL] Collection names. Defaults shown below.
QDRANT_CODEBASE_COLLECTION=codebase
QDRANT_INCIDENTS_COLLECTION=incidents

# -----------------------------------------------------------------------------
# PostgreSQL — Incidents, Users, Tickets
# -----------------------------------------------------------------------------
# [OPTIONAL] Default works with the bundled Postgres container.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cerno

# -----------------------------------------------------------------------------
# Security — JWT Authentication
# -----------------------------------------------------------------------------
# [REQUIRED] Change this to a random string (min 32 characters).
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# [OPTIONAL] JWT signing algorithm. HS256 is the default.
JWT_ALGORITHM=HS256

# [OPTIONAL] Token expiration in minutes.
JWT_EXPIRATION_MINUTES=60

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# [OPTIONAL] Requests per minute per IP address.
RATE_LIMIT_RPM=30

# [OPTIONAL] Incident submissions per hour per authenticated reporter.
RATE_LIMIT_SUBMISSIONS_PER_HOUR=5

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# [OPTIONAL] Set to "true" to run the full pipeline with simulated LLM
# responses, mock ticket creation, and mock notifications.
# No external API keys needed when enabled.
MOCK_MODE=false

# [OPTIONAL] "development" enables debug logging and hot reload.
# "production" disables debug output.
ENVIRONMENT=development

# [OPTIONAL] Log verbosity: debug, info, warning, error.
LOG_LEVEL=info

# [OPTIONAL] Number of Uvicorn workers for the backend.
BACKEND_WORKERS=1
